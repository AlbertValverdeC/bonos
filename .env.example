# OpenAI (guiones + thumbnails DALL-E)
OPENAI_API_KEY=
SCRIPTWRITER_MODEL=gpt-4o
SCRIPTWRITER_TEMPERATURE=0.7

# ElevenLabs (voiceover TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pexels (stock footage gratuito)
PEXELS_API_KEY=

# YouTube Data API v3 (for upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# YouTube Data API key (for research — free, read-only)
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Database
DATABASE_URL=sqlite:///data/bonos.db

# Server
FLASK_PORT=8001
VITE_PORT=5177
